---
import "../styles/global.css";
import Brand from "../components/Brand.astro";
import FounderCard from "../components/FounderCard.astro";
import { markdownPathForPage } from "../data/agent-pages";
import { footerNavigation, primaryNavigation, site } from "../data/site";

type Props = {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  type?: "website" | "article";
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
  markdownPath?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title,
  description = site.description,
  path = Astro.url.pathname,
  image = "/social-card.png",
  type = "website",
  robots = "index, follow, max-image-preview:large",
  publishedTime,
  modifiedTime,
  markdownPath: explicitMarkdownPath,
  schema,
} = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = new URL(path, Astro.site ?? site.origin).toString();
const socialImage = new URL(image, Astro.site ?? site.origin).toString();
const llmsUrl = new URL("/llms.txt", Astro.site ?? site.origin).toString();
const ardUrl = new URL("/.well-known/ard.json", Astro.site ?? site.origin).toString();
const markdownPath = explicitMarkdownPath ?? markdownPathForPage(path);
const markdownUrl = markdownPath ? new URL(markdownPath, Astro.site ?? site.origin).toString() : undefined;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrentPath = (href: string) => {
  const linkPath = href.replace(/\/+$/, "") || "/";
  return linkPath === "/"
    ? currentPath === "/"
    : currentPath === linkPath || currentPath.startsWith(`${linkPath}/`);
};
const baseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.origin}/#organization`,
      name: "pH7Software",
      url: site.githubOrganizationUrl,
      founder: { "@id": `${site.origin}/#creator` },
      sameAs: [site.githubOrganizationUrl],
    },
    {
      "@type": "Person",
      "@id": `${site.origin}/#creator`,
      name: site.author.name,
      url: `${site.origin}/about/`,
      jobTitle: "Founder and Software Engineer",
      sameAs: [site.author.url, site.author.linkedinUrl],
    },
    {
      "@type": ["SoftwareApplication", "SoftwareSourceCode"],
      "@id": `${site.origin}/#software`,
      name: site.name,
      alternateName: site.formerName,
      description: site.description,
      url: `${site.origin}/`,
      codeRepository: site.githubUrl,
      downloadUrl: site.latestReleaseUrl,
      softwareHelp: site.documentationUrl,
      programmingLanguage: "PHP",
      license: site.licence.url,
      softwareVersion: site.latestRelease,
      applicationCategory: "SocialNetworkingApplication",
      applicationSubCategory: "Dating, matchmaking and online community software",
      operatingSystem: "Server-side web application",
      softwareRequirements: site.latestReleaseRequirements,
      inLanguage: "en",
      isAccessibleForFree: true,
      keywords: ["open-source dating software", "self-hosted dating platform", "PHP dating script", "white-label dating software", "matchmaking website software", "dating CMS", "social networking platform"],
      featureList: ["Member profiles", "Discovery and matchmaking", "Private messaging", "Memberships", "Moderation controls", "Administration"],
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        category: "Open-source software",
        url: site.latestReleaseUrl,
      },
      creator: { "@id": `${site.origin}/#creator` },
      author: { "@id": `${site.origin}/#creator` },
      publisher: { "@id": `${site.origin}/#organization` },
    },
    {
      "@type": "WebSite",
      "@id": `${site.origin}/#website`,
      name: site.name,
      url: `${site.origin}/`,
      description: site.description,
      license: site.licence.url,
      about: { "@id": `${site.origin}/#software` },
      creator: { "@id": `${site.origin}/#creator` },
      publisher: { "@id": `${site.origin}/#organization` },
      inLanguage: "en",
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description,
      isPartOf: { "@id": `${site.origin}/#website` },
      about: { "@id": `${site.origin}/#software` },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: socialImage,
        width: 1200,
        height: 630,
      },
      ...(publishedTime ? { datePublished: publishedTime } : {}),
      ...(modifiedTime ? { dateModified: modifiedTime } : {}),
      inLanguage: "en",
    },
  ],
};
const schemas = schema
  ? [baseSchema, ...(Array.isArray(schema) ? schema : [schema])]
  : [baseSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#fff5ef" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — open-source dating software foundation`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${site.name} — open-source dating software foundation`} />
    <link rel="canonical" href={canonical} />
    <link rel="describedby" href={llmsUrl} />
    <link rel="ard" href={ardUrl} type="application/json" />
    {markdownUrl && <link rel="alternate" type="text/markdown" title={`${title} in Markdown`} href={markdownUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="pH7Builder articles" href="/rss.xml" />
    {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="shell nav-shell">
        <a class="brand-link" href="/" aria-label="pH7Builder home"><Brand /></a>
        <nav id="primary-navigation" class="primary-navigation" aria-label="Primary navigation">
          {primaryNavigation.map((item) => (
            <a href={item.href} aria-current={isCurrentPath(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        <a class="header-github" href={site.githubUrl} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in a new tab)</span></a>
        <button class="menu-button" type="button" aria-controls="primary-navigation" aria-expanded="false">
          <span class="sr-only">Open navigation</span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="shell">
        <div class="footer-lead">
          <a class="brand-link" href="/" aria-label="pH7Builder home"><Brand inverted /></a>
          <p>Build with an established open-source foundation. Keep your code, hosting choices and member relationships.</p>
        </div>
        <div class="footer-grid">
          {footerNavigation.map((group) => (
            <div>
              <h2>{group.title}</h2>
              <ul>
                {group.links.map((link) => (
                  <li>
                    <a href={link.href} target={"external" in link && link.external ? "_blank" : undefined} rel={"external" in link && link.external ? "noopener noreferrer" : undefined}>
                      {link.label}{"external" in link && link.external && <span class="sr-only"> (opens in a new tab)</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} pH7Builder. Open-source software under the <a href={site.licence.url} target="_blank" rel="license noopener noreferrer">{site.licence.name} licence</a>.</p>
          <FounderCard />
        </div>
      </div>
    </footer>
    <script>
      const menuButton = document.querySelector<HTMLButtonElement>(".menu-button");
      const navigation = document.querySelector<HTMLElement>(".primary-navigation");
      const label = menuButton?.querySelector<HTMLElement>(".sr-only");
      const closeNavigation = () => {
        document.body.classList.remove("navigation-open");
        menuButton?.setAttribute("aria-expanded", "false");
        if (label) label.textContent = "Open navigation";
      };

      menuButton?.addEventListener("click", () => {
        const isOpen = document.body.classList.toggle("navigation-open");
        menuButton.setAttribute("aria-expanded", String(isOpen));
        if (label) label.textContent = isOpen ? "Close navigation" : "Open navigation";
      });
      navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeNavigation));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && document.body.classList.contains("navigation-open")) {
          closeNavigation();
          menuButton?.focus();
        }
      });
      window.matchMedia("(min-width: 861px)").addEventListener("change", (event) => {
        if (event.matches) closeNavigation();
      });
    </script>
  </body>
</html>
