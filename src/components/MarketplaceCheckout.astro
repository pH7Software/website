---
import type { MarketplaceProduct } from "../data/marketplace";
import { marketplace } from "../data/marketplace";
import { contributionLabel, contributionMessage, formatUsd } from "../lib/marketplace.mjs";

type Props = {
  product: MarketplaceProduct;
};

const { product } = Astro.props;
const checkoutAvailable = marketplace.checkout.enabled
  && product.purchasable
  && product.verification.status === "verified";
---

<section
  class="checkout-panel"
  aria-labelledby="checkout-title"
  data-marketplace-checkout={checkoutAvailable ? "enabled" : "disabled"}
  data-product-id={product.id}
  data-product-version={product.version}
  data-minimum={product.pricing.minimum}
  data-suggested={product.pricing.suggested}
  data-api-origin={marketplace.checkout.apiOrigin}
>
  <div class="checkout-heading">
    <div>
      <p class="eyebrow">Pay what you wish</p>
      <h2 id="checkout-title">
        {checkoutAvailable ? "Choose what the extension is worth to you." : "Preview your contribution."}
      </h2>
    </div>
    <p>
      Every contribution receives the same complete package. The recommended amount
      supports testing, compatibility work and future fixes without a subscription.
    </p>
  </div>

  <form class="contribution-form">
    <fieldset aria-describedby="contribution-feedback">
      <legend>Contribution in US dollars</legend>
      <div class="contribution-options">
        {product.pricing.options.map((amount) => (
          <label class="contribution-option">
            <input
              type="radio"
              name="contribution"
              value={amount}
              checked={amount === product.pricing.suggested}
            />
            <span>
              <strong>{formatUsd(amount)}</strong>
              <small>{contributionLabel(product, amount)}</small>
            </span>
          </label>
        ))}
        <label class="contribution-option contribution-custom">
          <input type="radio" name="contribution" value="custom" />
          <span>
            <strong>Custom</strong>
            <small>{formatUsd(product.pricing.minimum)} or more</small>
          </span>
          <span class="custom-amount">
            <span aria-hidden="true">$</span>
            <input
              type="number"
              name="customAmount"
              min={product.pricing.minimum}
              step="0.01"
              inputmode="decimal"
              aria-label="Custom contribution in US dollars"
            />
          </span>
        </label>
      </div>
    </fieldset>

    <p id="contribution-feedback" class="contribution-feedback" data-contribution-message aria-live="polite">
      {contributionMessage({
        amount: product.pricing.suggested,
        minimum: product.pricing.minimum,
        suggested: product.pricing.suggested,
      })}
    </p>

    <div class="checkout-summary" aria-live="polite">
      <div>
        <p>{checkoutAvailable ? "Final amount" : "Contribution preview"}</p>
        <small>{checkoutAvailable ? "Confirmed again by PayPal" : "No payment can start yet"}</small>
      </div>
      <strong data-final-amount>{formatUsd(product.pricing.suggested)} USD</strong>
    </div>

    <ul class="checkout-assurances plain-list" aria-label="Purchase assurances">
      <li><strong>No marketplace account</strong><span>Use PayPal, then receive the protected download.</span></li>
      <li><strong>Server-verified payment</strong><span>A browser redirect alone can never release a package.</span></li>
      <li><strong>Purchase recovery</strong><span>Create a fresh expiring link with the PayPal order details.</span></li>
    </ul>

    {checkoutAvailable ? (
      <>
        <button class="button" type="submit">Continue securely with PayPal</button>
        <paypal-button hidden></paypal-button>
      </>
    ) : (
      <div id="release-status" class="checkout-paused">
        <div role="status">
          <strong>Release verification is in progress.</strong>
          <span>No payment can start yet. Try the amounts above to preview the exact total.</span>
        </div>
        <ol class="release-steps">
          <li><span>1</span><strong>Choose</strong><small>Preview a contribution</small></li>
          <li><span>2</span><strong>Review</strong><small>See the exact total</small></li>
          <li><span>3</span><strong>Pay later</strong><small>Only after checkout opens</small></li>
        </ol>
        <a href="#package-title">Review the package and compatibility</a>
      </div>
    )}

    <p class="checkout-terms">
      One payment. No subscription. Purchase means accepting the{" "}
      <a href="/marketplace/terms/">licence terms</a>{" "}and{" "}
      <a href="/marketplace/refunds/">refund policy</a>.
    </p>
    <p class="checkout-status" data-checkout-status aria-live="assertive"></p>
    <div class="checkout-result" data-checkout-result hidden></div>
  </form>
</section>

<script>
  import "../scripts/marketplace-checkout";
</script>

<style>
  .checkout-panel {
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--blue-soft);
    box-shadow: var(--shadow);
  }

  .checkout-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.62fr);
    align-items: end;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .checkout-heading h2 { margin-bottom: 0; font-size: clamp(2.2rem, 5vw, 4rem); }
  .checkout-heading > p { margin-bottom: 0; color: var(--ink-soft); }

  fieldset { padding: 0; border: 0; }
  legend { margin-bottom: 0.8rem; font-weight: 800; }
  .contribution-options {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .contribution-option {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.65rem;
    min-height: 5.5rem;
    padding: 0.9rem;
    border: 1px solid var(--ink);
    border-radius: 0.55rem;
    background: var(--paper-strong);
    cursor: pointer;
    transition: transform 150ms ease, background-color 150ms ease, box-shadow 150ms ease;
  }

  .contribution-option:hover { transform: translateY(-2px); }
  .contribution-option:focus-within { outline: 3px solid var(--coral); outline-offset: 3px; }

  .contribution-option:has(input:checked) {
    background: var(--lime);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .contribution-option > span:not(.custom-amount) { display: grid; }
  .contribution-option small { color: var(--ink-soft); }
  .contribution-option input[type="radio"] { width: 1.2rem; height: 1.2rem; accent-color: var(--blue); }

  .contribution-feedback {
    min-height: 1.75rem;
    margin: 1rem 0 0;
    color: var(--ink-soft);
    font-weight: 700;
  }

  .contribution-custom { grid-template-columns: auto auto; }
  .custom-amount {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.35rem;
  }

  .custom-amount input {
    width: 100%;
    min-width: 0;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--ink);
    border-radius: 0.3rem;
    background: white;
  }

  .checkout-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block: 1.5rem;
    padding: 1rem 1.15rem;
    border: 2px solid var(--ink);
    border-radius: 0.55rem;
    background: var(--paper-strong);
    box-shadow: 3px 3px 0 color-mix(in srgb, var(--ink) 18%, transparent);
  }

  .checkout-summary p { margin-bottom: 0; }
  .checkout-summary small { display: block; margin-top: 0.15rem; color: var(--ink-soft); }
  .checkout-summary strong { font-family: var(--serif); font-size: clamp(1.65rem, 4vw, 2.5rem); }

  .checkout-assurances {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0 0 1.5rem;
  }
  .checkout-assurances li {
    display: grid;
    gap: 0.2rem;
    padding: 0.85rem;
    border: 1px solid color-mix(in srgb, var(--ink) 28%, transparent);
    background: color-mix(in srgb, var(--paper-strong) 72%, transparent);
  }
  .checkout-assurances span { color: var(--ink-soft); font-size: 0.84rem; }

  .checkout-paused {
    display: grid;
    gap: 1rem;
    padding: 1.2rem;
    border: 1px solid var(--ink);
    border-radius: 0.45rem;
    background: var(--yellow);
  }
  .checkout-paused > div { display: grid; gap: 0.2rem; }
  .checkout-paused > a { width: fit-content; font-weight: 800; }
  .release-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .release-steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.05rem 0.5rem;
    align-items: center;
  }
  .release-steps li > span {
    display: grid;
    grid-row: 1 / span 2;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--paper-strong);
    font-family: var(--mono);
    font-weight: 800;
  }
  .release-steps small { color: var(--ink-soft); }

  .checkout-terms,
  .checkout-status { margin: 1rem 0 0; font-size: 0.88rem; }
  .checkout-status:empty { display: none; }

  .checkout-result {
    margin-top: 1rem;
    padding: 1rem;
    border: 2px solid var(--ink);
    background: var(--lime);
  }

  @media (max-width: 800px) {
    .checkout-heading { grid-template-columns: 1fr; }
    .contribution-options { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .checkout-assurances { grid-template-columns: 1fr; }
    .release-steps { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .contribution-options { grid-template-columns: 1fr; }
    .checkout-summary { align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .contribution-option { transition: none; }
    .contribution-option:hover { transform: none; }
  }
</style>
