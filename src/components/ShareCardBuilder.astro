---
import { defaultBuildShareCardInput } from "../lib/build-prompt";
---

<section class="share-card-section section" aria-labelledby="share-card-title" data-share-card-builder>
  <div class="shell share-card-grid">
    <div class="share-card-copy">
      <p class="eyebrow">Built to travel</p>
      <h2 id="share-card-title">Share the direction. Keep the private idea private.</h2>
      <p>Create a polished project card for a collaborator, community or social post. The PNG is generated in this browser.</p>

      <form class="public-card-fields" data-public-card-fields>
        <label>
          Public product name
          <input name="productName" type="text" maxlength="100" value={defaultBuildShareCardInput.productName} autocomplete="off" />
        </label>
        <label>
          Public audience
          <input name="audience" type="text" maxlength="180" value={defaultBuildShareCardInput.audience} autocomplete="off" />
        </label>
      </form>

      <p class="share-privacy-note"><strong>Only the public product name and audience above can appear.</strong> Your private idea and coding-agent choice are outside this component and cannot be added to the card.</p>
      <div class="tool-actions share-card-actions">
        <button class="button button-small" type="button" data-share-card hidden>Share project card</button>
        <button class="button button-secondary button-small" type="button" data-download-card>Download PNG</button>
      </div>
      <p class="share-card-status" data-share-card-status aria-live="polite"></p>
    </div>

    <figure class="share-card-preview">
      <canvas
        width="1200"
        height="630"
        data-share-card-canvas
        role="img"
        aria-label={`Share card preview for ${defaultBuildShareCardInput.productName}, built for ${defaultBuildShareCardInput.audience}`}
      ></canvas>
      <figcaption>1200 × 630 PNG · generated only in this browser</figcaption>
    </figure>
  </div>
</section>

<script>
  import {
    generateBuildShareCardSummary,
    slugifyBuildProductName,
    type BuildShareCardInput,
  } from "../lib/build-prompt";

  const root = document.querySelector<HTMLElement>("[data-share-card-builder]");
  const form = root?.querySelector<HTMLFormElement>("[data-public-card-fields]");
  const canvas = root?.querySelector<HTMLCanvasElement>("[data-share-card-canvas]");
  const status = root?.querySelector<HTMLElement>("[data-share-card-status]");
  const shareButton = root?.querySelector<HTMLButtonElement>("[data-share-card]");
  const downloadButton = root?.querySelector<HTMLButtonElement>("[data-download-card]");

  const readPublicInput = (): BuildShareCardInput => {
    const data = new FormData(form ?? undefined);
    return {
      productName: String(data.get("productName") ?? ""),
      audience: String(data.get("audience") ?? ""),
    };
  };

  const fitCanvasText = (context: CanvasRenderingContext2D, value: string, maximumWidth: number): string => {
    if (context.measureText(value).width <= maximumWidth) return value;
    let result = value;
    while (result.length > 1 && context.measureText(`${result}…`).width > maximumWidth) result = result.slice(0, -1);
    return `${result.trimEnd()}…`;
  };

  const wrapCanvasText = (
    context: CanvasRenderingContext2D,
    value: string,
    maximumWidth: number,
    maximumLines: number,
  ): string[] => {
    const lines: string[] = [];
    let line = "";
    for (const word of value.split(/\s+/).filter(Boolean)) {
      const candidate = line ? `${line} ${word}` : word;
      if (context.measureText(candidate).width <= maximumWidth) {
        line = candidate;
      } else {
        if (line) lines.push(line);
        line = context.measureText(word).width <= maximumWidth ? word : fitCanvasText(context, word, maximumWidth);
      }
    }
    if (line) lines.push(line);
    if (lines.length <= maximumLines) return lines;
    const visibleLines = lines.slice(0, maximumLines);
    visibleLines[maximumLines - 1] = fitCanvasText(context, lines.slice(maximumLines - 1).join(" "), maximumWidth);
    return visibleLines;
  };

  const drawShareCard = () => {
    const context = canvas?.getContext("2d");
    if (!canvas || !context) return;
    const summary = generateBuildShareCardSummary(readPublicInput());

    context.fillStyle = "#111628";
    context.fillRect(0, 0, canvas.width, canvas.height);
    context.strokeStyle = "rgba(255, 255, 255, 0.08)";
    context.lineWidth = 1;
    for (let x = 0; x <= canvas.width; x += 48) {
      context.beginPath();
      context.moveTo(x, 0);
      context.lineTo(x, canvas.height);
      context.stroke();
    }
    for (let y = 0; y <= canvas.height; y += 48) {
      context.beginPath();
      context.moveTo(0, y);
      context.lineTo(canvas.width, y);
      context.stroke();
    }

    context.fillStyle = "#c8ef5a";
    context.fillRect(0, 0, 18, canvas.height);
    context.fillRect(1090, 0, 110, 18);
    context.fillStyle = "#ff6047";
    context.beginPath();
    context.arc(1100, 88, 12, 0, Math.PI * 2);
    context.fill();

    context.fillStyle = "#c8ef5a";
    context.strokeStyle = "#fffdf7";
    context.lineWidth = 3;
    context.beginPath();
    context.roundRect(72, 62, 72, 54, 9);
    context.fill();
    context.stroke();
    context.fillStyle = "#111628";
    context.font = "800 24px ui-monospace, SFMono-Regular, Consolas, monospace";
    context.fillText("pH7", 86, 97);

    context.fillStyle = "#fffdf7";
    context.font = "800 29px ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif";
    context.fillText("pH7Builder", 166, 99);
    context.fillStyle = "#aeb4c8";
    context.font = "700 19px ui-monospace, SFMono-Regular, Consolas, monospace";
    context.fillText("PORTABLE PRODUCT DIRECTION", 766, 96);

    context.fillStyle = "#fffdf7";
    context.font = "800 72px ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif";
    const productLines = wrapCanvasText(context, summary.productName, 920, 2);
    productLines.forEach((line, index) => context.fillText(line, 72, 218 + (index * 78)));
    const audienceY = productLines.length === 1 ? 304 : 374;
    context.fillStyle = "#c8ef5a";
    context.font = "700 29px ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif";
    const audienceLines = wrapCanvasText(context, `Built for ${summary.audience}`, 920, 2);
    audienceLines.forEach((line, index) => context.fillText(line, 74, audienceY + (index * 38)));

    let badgeX = 74;
    const badgeY = audienceY + (audienceLines.length * 38) + 36;
    context.font = "700 19px ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif";
    summary.badges.forEach((badge) => {
      const width = Math.ceil(context.measureText(badge).width) + 40;
      context.fillStyle = "rgba(255, 253, 247, 0.06)";
      context.strokeStyle = "#697089";
      context.lineWidth = 2;
      context.beginPath();
      context.roundRect(badgeX, badgeY, width, 42, 7);
      context.fill();
      context.stroke();
      context.fillStyle = "#fffdf7";
      context.fillText(badge, badgeX + 20, badgeY + 28);
      badgeX += width + 12;
    });

    context.fillStyle = "#aeb4c8";
    context.font = "700 17px ui-monospace, SFMono-Regular, Consolas, monospace";
    context.fillText("CUSTOMER-OWNED  ·  AGENT-READY", 72, 577);
    context.fillStyle = "#c8ef5a";
    context.textAlign = "right";
    context.fillText("ph7builder.com/build", 1128, 577);
    context.textAlign = "left";

    canvas.setAttribute("aria-label", `Share card preview for ${summary.productName}, built for ${summary.audience}`);
  };

  const shareCardBlob = (): Promise<Blob | null> => new Promise((resolve) => {
    if (!canvas) {
      resolve(null);
      return;
    }
    canvas.toBlob(resolve, "image/png");
  });

  const downloadShareCard = async () => {
    const blob = await shareCardBlob();
    if (!blob) {
      if (status) status.textContent = "The card could not be generated in this browser.";
      return;
    }
    const summary = generateBuildShareCardSummary(readPublicInput());
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = `${slugifyBuildProductName(summary.productName)}.project-card.png`;
    link.click();
    URL.revokeObjectURL(url);
    if (status) status.textContent = "Project card downloaded.";
  };

  form?.addEventListener("input", drawShareCard);
  downloadButton?.addEventListener("click", downloadShareCard);

  if (shareButton && typeof navigator.share === "function" && typeof navigator.canShare === "function") {
    const probe = new File(["pH7Builder"], "ph7builder.txt", { type: "text/plain" });
    if (navigator.canShare({ files: [probe] })) shareButton.hidden = false;
  }

  shareButton?.addEventListener("click", async () => {
    const blob = await shareCardBlob();
    if (!blob) {
      if (status) status.textContent = "The card could not be generated in this browser.";
      return;
    }
    const summary = generateBuildShareCardSummary(readPublicInput());
    const file = new File([blob], `${slugifyBuildProductName(summary.productName)}.project-card.png`, { type: "image/png" });
    if (!navigator.canShare?.({ files: [file] })) {
      await downloadShareCard();
      return;
    }
    try {
      await navigator.share({
        files: [file],
        title: `${summary.productName} — pH7Builder project direction`,
        text: "A product direction created with the local-only pH7Builder build tool.",
      });
      if (status) status.textContent = "Project card ready.";
    } catch (error) {
      if (error instanceof DOMException && error.name === "AbortError") return;
      if (status) status.textContent = "Sharing was unavailable. Download the PNG instead.";
    }
  });

  drawShareCard();
</script>

<style>
  .share-card-section {
    margin-top: clamp(4rem, 8vw, 8rem);
    border-block: 1px solid var(--line);
    background: var(--ink);
    color: var(--paper-strong);
  }

  .share-card-grid {
    display: grid;
    grid-template-columns: minmax(18rem, 0.65fr) minmax(0, 1.35fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .share-card-copy h2 {
    max-width: 12ch;
  }

  .share-card-copy > p:not(.eyebrow) {
    max-width: 38rem;
    color: #c4c8d5;
    font-size: 1.06rem;
  }

  .public-card-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-block: 1.75rem 1rem;
  }

  .public-card-fields label {
    display: grid;
    gap: 0.35rem;
    color: var(--paper-strong);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .public-card-fields input {
    min-width: 0;
    padding: 0.75rem;
    border: 1px solid #697089;
    border-radius: 0.35rem;
    background: #20263a;
    color: white;
  }

  .share-privacy-note {
    padding: 1rem 1.1rem;
    border-left: 0.35rem solid var(--lime);
    background: rgba(255, 255, 255, 0.06);
  }

  .share-card-actions .button {
    border-color: var(--paper-strong);
  }

  .share-card-actions .button-secondary {
    background: transparent;
    color: var(--paper-strong);
  }

  .share-card-actions .button-secondary:hover {
    background: var(--paper-strong);
    color: var(--ink);
  }

  .share-card-status {
    min-height: 1.5rem;
    margin: 0.75rem 0 0;
    color: #c4c8d5;
    font-size: 0.85rem;
  }

  .share-card-preview {
    margin: 0;
  }

  .share-card-preview canvas {
    width: 100%;
    height: auto;
    border: 2px solid var(--paper-strong);
    border-radius: 0.75rem;
    box-shadow: 12px 12px 0 var(--lime);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .share-card-preview:hover canvas {
    box-shadow: 16px 16px 0 var(--coral);
    transform: translate(-4px, -4px) rotate(-0.35deg);
  }

  .share-card-preview figcaption {
    margin-top: 1.25rem;
    color: #aeb4c8;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-align: right;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .share-card-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .public-card-fields {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .share-card-preview canvas {
      transition: none;
    }

    .share-card-preview:hover canvas {
      transform: none;
    }
  }
</style>
