---
import ArrowIcon from "./ArrowIcon.astro";

type Props = {
  number: string;
  eyebrow: string;
  title: string;
  description: string;
  href: string;
  linkLabel: string;
  tone?: "lime" | "blue" | "coral";
};

const { number, eyebrow, title, description, href, linkLabel, tone = "lime" } = Astro.props;
---

<article class:list={["path-card", `path-card-${tone}`]}>
  <div class="path-card-top">
    <span class="path-number">{number}</span>
    <span class="eyebrow">{eyebrow}</span>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <a class="text-link" href={href}>{linkLabel}<ArrowIcon /></a>
</article>
