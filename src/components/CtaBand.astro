---
import ArrowIcon from "./ArrowIcon.astro";

type Props = {
  eyebrow?: string;
  title?: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
};

const {
  eyebrow = "Build on the foundation",
  title = "Your idea. Your dating app. Your business.",
  description = "Start with a portable blueprint, then install and customise the open-source application with your preferred AI coding agent.",
  primaryLabel = "Create your blueprint",
  primaryHref = "/build/",
  secondaryLabel = "Get pH7Builder",
  secondaryHref = "/get-started/",
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-band-title">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="cta-band-title">{title}</h2>
    <p>{description}</p>
  </div>
  <div class="cta-actions">
    <a class="button button-light" href={primaryHref}>{primaryLabel}<ArrowIcon /></a>
    <a class="text-link text-link-light" href={secondaryHref}>{secondaryLabel}<ArrowIcon /></a>
  </div>
</section>
