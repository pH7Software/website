---
import { site } from "../data/site";
---

<div class="footer-founder-card">
  <a
    class="footer-founder-profile"
    href={site.author.linkedinUrl}
    target="_blank"
    rel="author noopener noreferrer"
    aria-label={`Follow ${site.author.name}, creator of pH7Builder, on LinkedIn`}
  >
    <span class="footer-founder-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false">
        <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM3.56 9h3.56v11.45H3.56V9Z"></path>
      </svg>
    </span>
    <span class="footer-founder-copy">
      <strong>Built independently by {site.author.firstName}</strong>
      <small>Follow the creator on LinkedIn</small>
    </span>
  </a>
  <div class="footer-founder-actions" aria-label="Work with the creator or support pH7Builder">
    <a href="/services/custom-development/">Hire {site.author.firstName}</a>
    <a href={site.sponsorUrl} target="_blank" rel="noopener noreferrer">Support the project<span class="sr-only"> on GitHub Sponsors (opens in a new tab)</span></a>
  </div>
</div>
