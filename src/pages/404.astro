---
import ArrowIcon from "../components/ArrowIcon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The requested pH7Builder page could not be found." path="/404.html" robots="noindex, follow">
  <section class="not-found shell">
    <p class="eyebrow">404 · Page not found</p>
    <h1>This route is not in the blueprint.</h1>
    <p class="lede">The page may have moved during the WordPress migration. Try the article archive, changelog or current product pages.</p>
    <div class="hero-actions">
      <a class="button" href="/">Return home<ArrowIcon /></a>
      <a class="text-link" href="/articles/">Browse articles<ArrowIcon /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { min-height: 70vh; padding-block: clamp(5rem, 12vw, 11rem); }
  .not-found h1 { max-width: 10ch; }
</style>
