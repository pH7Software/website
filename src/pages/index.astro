---
import ArrowIcon from "../components/ArrowIcon.astro";
import BlueprintDiagram from "../components/BlueprintDiagram.astro";
import CtaBand from "../components/CtaBand.astro";
import PathCard from "../components/PathCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title={site.name} description="Build an independently owned dating app, matchmaking service or online community with pH7Builder's open-source, AI-ready foundation." path="/">
  <section class="home-hero">
    <div class="shell home-hero-grid">
      <div>
        <p class="eyebrow">Open source · Self-hosted · Built for extension</p>
        <h1>Build the dating product you actually mean.</h1>
        <p class="lede">Start with profiles, discovery, matchmaking, messaging, memberships and moderation. Let your AI coding agent customise what makes your business different.</p>
        <div class="hero-actions">
          <a class="button" href="/build/">Create a portable blueprint<ArrowIcon /></a>
          <a class="text-link" href={site.githubUrl} target="_blank" rel="noopener noreferrer">View the source on GitHub<ArrowIcon /><span class="sr-only"> (opens in a new tab)</span></a>
        </div>
        <p class="release-note"><span class="status-pill">Current</span> Latest published release: <a href="/changelog/">pH7Builder {site.latestRelease}</a></p>
      </div>
      <BlueprintDiagram />
    </div>
  </section>

  <section class="foundation-strip" aria-label="pH7Builder foundation">
    <div class="shell foundation-grid">
      <p><strong>Years of product work</strong><span>used as a foundation, not discarded</span></p>
      <p><strong>Independent ownership</strong><span>your code, infrastructure choices and member relationships</span></p>
      <p><strong>Agent-ready direction</strong><span>documented decisions, testable changes and portable specifications</span></p>
    </div>
  </section>

  <section class="section surface">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Not another empty starter</p>
          <h2>Begin with the hard parts already represented.</h2>
        </div>
        <p>AI can generate screens quickly. A real dating product also needs account flows, privacy decisions, discovery rules, communication, moderation and a path to sustainable operations.</p>
      </div>
      <div class="capability-map">
        <div class="capability-core">
          <span class="eyebrow">Your unique product</span>
          <strong>Niche, brand, rules and member experience</strong>
        </div>
        <div class="capability-connector" aria-hidden="true">builds on</div>
        <div class="capability-foundation">
          {[
            ["01", "Profiles & identity"],
            ["02", "Discovery & matching"],
            ["03", "Messaging & connection"],
            ["04", "Memberships"],
            ["05", "Moderation controls"],
            ["06", "Admin operations"],
          ].map(([number, label]) => <span><b>{number}</b>{label}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">What could you build?</p>
          <h2>One foundation. Different businesses.</h2>
        </div>
        <p>The useful question is not how many features fit on a page. It is whether the foundation can support the experience your members need.</p>
      </div>
      <div class="outcome-grid">
        <article class="outcome-card outcome-card-coral">
          <span>01 / NICHE DATING</span>
          <h3>People living between cities</h3>
          <p>Connect travellers and expats through destinations, languages, lifestyle and privacy-conscious travel plans.</p>
          <a class="text-link" href="/blueprints/nomad-connections/">Explore Nomad Connections<ArrowIcon /></a>
        </article>
        <article class="outcome-card outcome-card-blue">
          <span>02 / MATCHMAKING</span>
          <h3>A private introduction service</h3>
          <p>Use application-based membership, controlled profile visibility, curated introductions and paid consultations.</p>
          <a class="text-link" href="/build/">Create this blueprint<ArrowIcon /></a>
        </article>
        <article class="outcome-card outcome-card-yellow">
          <span>03 / COMMUNITY</span>
          <h3>Connection beyond dating</h3>
          <p>Adapt the social foundation for friendship, activity partners or a focused community with its own participation rules.</p>
          <a class="text-link" href="/vibe-coders/">See the guided path<ArrowIcon /></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section surface">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Two ways to move</p>
          <h2>Build independently or work with the creator.</h2>
        </div>
        <p>The source remains open. Choose the path that fits your technical confidence, time and business risk.</p>
      </div>
      <div class="path-grid">
        <PathCard number="01" eyebrow="Independent builders" title="Build with your favourite AI coding agent." description="Generate a portable product blueprint, install pH7Builder through Composer, and give Codex, Claude Code or another capable agent a precise starting point." href="/ai-builders/" linkLabel="Use the technical path" tone="lime" />
        <PathCard number="02" eyebrow="Custom delivery" title="Work directly with the person behind pH7Builder." description="For products where architecture, privacy, migration or launch risk needs experienced judgement, engage Pierre-Henry for a focused custom build." href="/services/custom-development/" linkLabel="Discuss the product" tone="blue" />
      </div>
    </div>
  </section>

  <section class="section principle-section">
    <div class="shell principle-grid">
      <div>
        <p class="eyebrow">The operating principle</p>
        <h2>Own the product logic that makes you different.</h2>
      </div>
      <div class="principle-copy">
        <p>Keep the relationship model, matching rules and member experience under your control. Connect specialist services for payments, email or notifications when that reduces operational burden.</p>
        <p>A clear API boundary can eventually serve the web product, mobile applications, third-party integrations and AI agents without rebuilding the same business rules each time.</p>
        <a class="text-link" href="/ai-builders/">See the AI-ready direction<ArrowIcon /></a>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .home-hero {
    padding-block: clamp(4.5rem, 9vw, 9rem);
    overflow: hidden;
  }

  .home-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.75fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
  }

  .home-hero h1 {
    max-width: 10ch;
    margin-bottom: 1.5rem;
  }

  .home-hero .lede {
    max-width: 42rem;
  }

  .release-note {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 2rem 0 0;
    color: var(--ink-soft);
    font-size: 0.86rem;
  }

  .foundation-strip {
    border-block: 1px solid var(--ink);
    background: var(--lime);
  }

  .foundation-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .foundation-grid p {
    padding: 1.5rem;
    margin: 0;
  }

  .foundation-grid p + p {
    border-left: 1px solid var(--ink);
  }

  .foundation-grid strong,
  .foundation-grid span {
    display: block;
  }

  .foundation-grid span {
    margin-top: 0.2rem;
    color: #3e471f;
    font-size: 0.85rem;
  }

  .capability-map {
    display: grid;
    grid-template-columns: minmax(0, 0.65fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1.25rem;
  }

  .capability-core {
    display: flex;
    min-height: 18rem;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--coral);
    box-shadow: var(--shadow);
  }

  .capability-core strong {
    max-width: 13ch;
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.02;
  }

  .capability-connector {
    font-family: var(--mono);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .capability-foundation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .capability-foundation span {
    display: flex;
    min-height: 7.5rem;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    border: 1px solid var(--ink);
    background: var(--paper-strong);
    font-weight: 800;
  }

  .capability-foundation b {
    font-family: var(--mono);
    font-size: 0.68rem;
  }

  .outcome-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .outcome-card {
    display: flex;
    min-height: 27rem;
    flex-direction: column;
    padding: 1.75rem;
    border: 2px solid var(--ink);
    border-radius: 0.8rem;
  }

  .outcome-card:nth-child(1) { grid-column: span 5; }
  .outcome-card:nth-child(2) { grid-column: span 4; }
  .outcome-card:nth-child(3) { grid-column: span 3; }

  .outcome-card-coral { background: #ffdcd5; }
  .outcome-card-blue { background: var(--blue-soft); }
  .outcome-card-yellow { background: var(--yellow); }

  .outcome-card > span {
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .outcome-card h3 {
    margin: auto 0 1rem;
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3.1rem);
  }

  .outcome-card .text-link {
    margin-top: 1rem;
  }

  .principle-section {
    background: var(--blue);
    color: white;
  }

  .principle-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.65fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .principle-grid h2 {
    max-width: 13ch;
    margin-bottom: 0;
  }

  .principle-copy {
    align-self: end;
    color: #e4e8ff;
    font-size: 1.1rem;
  }

  .principle-copy .text-link {
    margin-top: 1rem;
    color: white;
    text-decoration-color: var(--lime);
  }

  @media (max-width: 900px) {
    .home-hero-grid,
    .capability-map,
    .principle-grid {
      grid-template-columns: 1fr;
    }

    .capability-connector {
      writing-mode: initial;
    }

    .outcome-card:nth-child(n) {
      grid-column: span 12;
      min-height: 21rem;
    }
  }

  @media (max-width: 680px) {
    .foundation-grid {
      grid-template-columns: 1fr;
    }

    .foundation-grid p + p {
      border-top: 1px solid var(--ink);
      border-left: 0;
    }

    .capability-foundation {
      grid-template-columns: 1fr;
    }
  }
</style>
