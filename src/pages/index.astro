---
import ArrowIcon from "../components/ArrowIcon.astro";
import BlueprintDiagram from "../components/BlueprintDiagram.astro";
import CtaBand from "../components/CtaBand.astro";
import PathCard from "../components/PathCard.astro";
import ProductPreview from "../components/ProductPreview.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="Open-Source Dating Software" description={site.description} path="/">
  <section class="home-hero">
    <div class="shell home-hero-grid">
      <div>
        <p class="eyebrow">Open source · Self-hosted · Built for extension</p>
        <h1>Build connections. Own your business.</h1>
        <p class="lede">Use pH7Builder as the open-source foundation for your dating or matchmaking app. Let your preferred coding agent customise what makes the business different.</p>
        <div class="hero-actions">
          <a class="button" href="/build/">Build with AI<ArrowIcon /></a>
          <a class="text-link" href={site.githubUrl} target="_blank" rel="noopener noreferrer">View the source on GitHub<ArrowIcon /><span class="sr-only"> (opens in a new tab)</span></a>
        </div>
        <p class="release-note"><span class="status-pill">Current</span> Latest published release: <a href="/changelog/">pH7Builder {site.latestRelease}</a></p>
      </div>
      <BlueprintDiagram />
    </div>
  </section>

  <section class="foundation-strip" aria-label="pH7Builder foundation">
    <div class="shell foundation-grid">
      <p><strong>Years of product work</strong><span>used as a foundation, not discarded</span></p>
      <p><strong>Independent ownership</strong><span>your code, infrastructure choices and member relationships</span></p>
      <p><strong>Agent-ready direction</strong><span>documented decisions, testable changes and portable specifications</span></p>
    </div>
  </section>

  <section class="section identity-section" aria-labelledby="what-is-ph7builder">
    <div class="shell identity-grid">
      <div>
        <p class="eyebrow">What is pH7Builder?</p>
        <h2 id="what-is-ph7builder">Open-source dating software you host and control.</h2>
      </div>
      <div class="identity-answer">
        <p><strong>pH7Builder, formerly pH7CMS,</strong> is a self-hosted PHP platform for creating white-label dating websites, matchmaking services, social networks and online communities.</p>
        <p>It provides established profiles, discovery, matchmaking, messaging, memberships, moderation and administration. Developers can adapt its modules, themes and business rules instead of rebuilding those product foundations from an empty repository.</p>
        <dl>
          <div><dt>Licence</dt><dd><a href={site.licence.url} target="_blank" rel="license noopener noreferrer">MIT open source<span class="sr-only"> (opens in a new tab)</span></a></dd></div>
          <div><dt>Current release</dt><dd><a href={site.latestReleaseUrl} target="_blank" rel="noopener noreferrer">{site.latestRelease}<span class="sr-only"> (opens in a new tab)</span></a></dd></div>
          <div><dt>Requirements</dt><dd>PHP 8.3–8.5 and MySQL 8.0+</dd></div>
          <div><dt>Deployment</dt><dd>Your own compatible web server</dd></div>
        </dl>
        <div class="identity-links">
          <a class="text-link" href="/get-started/">How to install pH7Builder<ArrowIcon /></a>
          <a class="text-link" href={site.docsUrl} target="_blank" rel="noopener noreferrer">Read the versioned documentation<ArrowIcon /><span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </div>
    </div>
  </section>

  <ProductPreview />

  <section class="section surface">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Not another empty starter</p>
          <h2>Begin with the hard parts already represented.</h2>
        </div>
        <p>AI can generate screens quickly. A real dating product also needs account flows, privacy decisions, discovery rules, communication, moderation and a path to sustainable operations.</p>
      </div>
      <div class="capability-map">
        <div class="capability-core">
          <span class="eyebrow">Your unique product</span>
          <strong>Niche, brand, rules and member experience</strong>
        </div>
        <div class="capability-connector" aria-hidden="true">builds on</div>
        <div class="capability-foundation">
          {[
            ["01", "Profiles & identity"],
            ["02", "Discovery & matching"],
            ["03", "Messaging & connection"],
            ["04", "Memberships"],
            ["05", "Moderation controls"],
            ["06", "Admin operations"],
          ].map(([number, label]) => <span><b>{number}</b>{label}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section surface">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Two ways to move</p>
          <h2>From product idea to working application.</h2>
        </div>
        <p>Start with a clear blueprint, then install and adapt the published software. Keep your code and hosting under your control.</p>
      </div>
      <div class="path-grid">
        <PathCard number="01" eyebrow="Build it yourself" title="Build with your favourite AI coding agent." description="Describe the idea, receive a complete execution prompt and keep a portable blueprint with your independently owned application." href="/build/" linkLabel="Generate the build prompt" tone="lime" />
        <PathCard number="02" eyebrow="Work with the creator" title="Bring experienced engineering into the parts that carry real risk." description="Get focused help with a launch, custom product, migration or AI-built prototype without turning the free path into a dead end." href="/services/" linkLabel="Review services and pricing" tone="blue" />
      </div>
    </div>
  </section>

  <section class="section principle-section">
    <div class="shell principle-grid">
      <div>
        <p class="eyebrow">The operating principle</p>
        <h2>Own the product logic that makes you different.</h2>
      </div>
      <div class="principle-copy">
        <p>Keep the relationship model, matching rules and member experience under your control. Connect specialist services for payments, email or notifications when that reduces operational burden.</p>
        <p>A clear API boundary can eventually serve the web product, mobile applications, third-party integrations and AI agents without rebuilding the same business rules each time.</p>
        <a class="text-link" href="/ai-builders/">See the AI-ready direction<ArrowIcon /></a>
      </div>
    </div>
  </section>

  <CtaBand secondaryLabel="Review professional services" secondaryHref="/services/" />
</BaseLayout>

<style>
  .home-hero {
    padding-block: clamp(4.5rem, 9vw, 9rem);
    overflow: hidden;
  }

  .home-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.75fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
  }

  .home-hero-grid > * {
    min-width: 0;
  }

  .home-hero h1 {
    max-width: 10ch;
    margin-bottom: 1.5rem;
  }

  .home-hero .lede {
    max-width: 42rem;
  }

  .release-note {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 2rem 0 0;
    color: var(--ink-soft);
    font-size: 0.86rem;
  }

  .foundation-strip {
    border-block: 1px solid var(--ink);
    background: var(--lime);
  }

  .foundation-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .foundation-grid p {
    padding: 1.5rem;
    margin: 0;
  }

  .foundation-grid p + p {
    border-left: 1px solid var(--ink);
  }

  .foundation-grid strong,
  .foundation-grid span {
    display: block;
  }

  .identity-section {
    background: var(--paper-strong);
  }

  .identity-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(20rem, 1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .identity-grid h2 {
    max-width: 12ch;
    margin-bottom: 0;
  }

  .identity-answer > p {
    max-width: 48rem;
    font-size: 1.08rem;
  }

  .identity-answer dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 2rem 0;
    border: 2px solid var(--ink);
  }

  .identity-answer dl div {
    min-height: 7.5rem;
    padding: 1.2rem;
    border: 1px solid var(--ink);
    background: var(--paper);
  }

  .identity-answer dt {
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .identity-answer dd {
    margin: 1.25rem 0 0;
    font-weight: 800;
  }

  .identity-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
  }

  .foundation-grid span {
    margin-top: 0.2rem;
    color: #3e471f;
    font-size: 0.85rem;
  }

  .capability-map {
    display: grid;
    grid-template-columns: minmax(0, 0.65fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1.25rem;
  }

  .capability-core {
    display: flex;
    min-height: 18rem;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--coral);
    box-shadow: var(--shadow);
  }

  .capability-core strong {
    max-width: 13ch;
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.02;
  }

  .capability-connector {
    font-family: var(--mono);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .capability-foundation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .capability-foundation span {
    display: flex;
    min-height: 7.5rem;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    border: 1px solid var(--ink);
    background: var(--paper-strong);
    font-weight: 800;
  }

  .capability-foundation b {
    font-family: var(--mono);
    font-size: 0.68rem;
  }

  .principle-section {
    background: var(--blue);
    color: white;
  }

  .principle-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.65fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .principle-grid h2 {
    max-width: 13ch;
    margin-bottom: 0;
  }

  .principle-copy {
    align-self: end;
    color: #e4e8ff;
    font-size: 1.1rem;
  }

  .principle-copy .text-link {
    margin-top: 1rem;
    color: white;
    text-decoration-color: var(--lime);
  }

  @media (max-width: 900px) {
    .home-hero-grid,
    .identity-grid,
    .capability-map,
    .principle-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .capability-connector {
      writing-mode: initial;
    }

  }

  @media (max-width: 680px) {
    .foundation-grid {
      grid-template-columns: 1fr;
    }

    .foundation-grid p + p {
      border-top: 1px solid var(--ink);
      border-left: 0;
    }

    .capability-foundation {
      grid-template-columns: 1fr;
    }

    .identity-answer dl {
      grid-template-columns: 1fr;
    }
  }
</style>
