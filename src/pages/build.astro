---
import ArrowIcon from "../components/ArrowIcon.astro";
import ServiceOffers from "../components/ServiceOffers.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildAgents, exampleBuildIdeas, maximumIdeaLength, nomadBuildIdea } from "../lib/build-prompt";
---

<BaseLayout
  title="Build your dating app with AI"
  description="Describe your dating or matchmaking idea, choose your coding agent and receive a complete pH7Builder execution prompt plus a portable blueprint. Everything runs in your browser."
  path="/build/"
>
  <header class="build-header shell">
    <div>
      <p class="eyebrow">Build with AI</p>
      <h1>Start building your unique dating app in minutes.</h1>
    </div>
    <div>
      <p class="lede">Describe your idea. Get a personalised prompt for your coding agent. Start with pH7Builder and own what you create.</p>
      <p class="scope-note">This starts the build process. A customised production business takes further engineering, testing and operating work.</p>
    </div>
  </header>

  <div class="builder-shell shell" data-build-prompt>
    <section class="builder-form-panel" aria-labelledby="build-input-title">
      <div class="panel-heading">
        <span class="step-box">01</span>
        <div>
          <h2 id="build-input-title">Describe your idea</h2>
          <p>Your idea stays in this browser page.</p>
        </div>
      </div>

      <form id="build-form">
        <label for="application-idea">What dating app do you want to build?</label>
        <textarea id="application-idea" name="idea" rows="9" maxlength={maximumIdeaLength} required>{nomadBuildIdea}</textarea>
        <p class="field-help"><span data-character-count>{nomadBuildIdea.length}</span> / {maximumIdeaLength} characters</p>

        <div class="example-ideas" aria-labelledby="example-ideas-title">
          <p id="example-ideas-title">Try an example</p>
          <div>
            {exampleBuildIdeas.map((idea, index) => (
              <button type="button" data-example={idea}>{index === 0 ? "Travel and expat dating" : index === 1 ? "Fitness dating" : index === 2 ? "Serious matchmaking" : "Digital nomads"}</button>
            ))}
          </div>
        </div>

        <fieldset>
          <legend>Choose your coding agent</legend>
          <div class="agent-options">
            {buildAgents.map((agent, index) => (
              <label>
                <input type="radio" name="agentId" value={agent.id} checked={index === 0} />
                <span>{agent.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <button class="button button-dark" type="submit">Generate my build prompt<ArrowIcon /></button>
        <p class="privacy-note">No account. No AI API. No idea stored or transmitted.</p>
      </form>
    </section>

    <section class="builder-output-panel" aria-labelledby="build-output-title">
      <div class="panel-heading">
        <span class="step-box">02</span>
        <div>
          <h2 id="build-output-title">Take the prompt</h2>
          <p>Review it before giving it to your agent.</p>
        </div>
      </div>

      <div class="output-tabs" role="tablist" aria-label="Generated build files">
        <button id="prompt-tab" type="button" role="tab" aria-selected="true" aria-controls="prompt-panel">Execution prompt</button>
        <button id="blueprint-tab" type="button" role="tab" aria-selected="false" aria-controls="blueprint-panel" tabindex="-1">Portable blueprint</button>
      </div>
      <div id="prompt-panel" role="tabpanel" aria-labelledby="prompt-tab"><pre tabindex="0"><code data-prompt-output></code></pre></div>
      <div id="blueprint-panel" role="tabpanel" aria-labelledby="blueprint-tab" hidden><pre tabindex="0"><code data-blueprint-output></code></pre></div>

      <p class="output-status" aria-live="polite"></p>
      <div class="tool-actions">
        <button class="button button-small" type="button" data-copy-prompt>Copy execution prompt</button>
        <button class="button button-secondary button-small" type="button" data-copy-blueprint>Copy blueprint</button>
        <button class="button button-secondary button-small" type="button" data-download-files>Download both files</button>
      </div>

      <div class="output-note">
        <strong>What happens next?</strong>
        <ol>
          <li>Open a new project folder in a capable coding agent with terminal and filesystem access.</li>
          <li>Paste the execution prompt and let the agent inspect the environment.</li>
          <li>Keep the downloaded blueprint with the application so another agent or developer can continue later.</li>
        </ol>
      </div>
    </section>
  </div>

  <section class="section-tight narrow-shell build-explanation">
    <p class="eyebrow">What this gives you</p>
    <h2>A serious starting brief, not a pretend generated application.</h2>
    <p>The execution prompt tells a capable agent how to inspect, install, customise and verify the published pH7Builder release. The blueprint records your original intent separately from the implementation.</p>
    <p>You still choose the tools, approve sensitive operations and decide when the application is ready for real members.</p>
  </section>

  <section class="section surface" aria-labelledby="build-help-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Choose your path</p>
          <h2 id="build-help-title">Build independently or bring in experienced help.</h2>
        </div>
        <p>The free path remains complete. Professional work is optional and scoped around a real launch or product requirement.</p>
      </div>
      <ServiceOffers />
      <p class="service-disclaimer">Professional prices are starting points in USD. Final scope, availability and responsibilities are agreed before work begins. Your own coding-agent, hosting and third-party service costs are separate.</p>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    buildAgents,
    generateBuildBlueprint,
    generateBuildPrompt,
    type BuildAgentId,
    type BuildPromptInput,
  } from "../lib/build-prompt";

  const root = document.querySelector<HTMLElement>("[data-build-prompt]");
  const form = root?.querySelector<HTMLFormElement>("#build-form");
  const ideaField = root?.querySelector<HTMLTextAreaElement>("#application-idea");
  const promptOutput = root?.querySelector<HTMLElement>("[data-prompt-output]");
  const blueprintOutput = root?.querySelector<HTMLElement>("[data-blueprint-output]");
  const status = root?.querySelector<HTMLElement>(".output-status");
  const characterCount = root?.querySelector<HTMLElement>("[data-character-count]");
  const tabs = Array.from(root?.querySelectorAll<HTMLButtonElement>("[role='tab']") ?? []);

  const setStatus = (message: string) => {
    if (status) status.textContent = message;
  };

  const readInput = (): BuildPromptInput => {
    const data = new FormData(form ?? undefined);
    const requestedAgent = String(data.get("agentId") ?? "other");
    const agentId = buildAgents.some((agent) => agent.id === requestedAgent) ? requestedAgent as BuildAgentId : "other";
    return { idea: String(data.get("idea") ?? ""), agentId };
  };

  const renderFiles = () => {
    const input = readInput();
    if (promptOutput) promptOutput.textContent = generateBuildPrompt(input);
    if (blueprintOutput) blueprintOutput.textContent = generateBuildBlueprint(input);
  };

  const selectTab = (selected: HTMLButtonElement) => {
    tabs.forEach((tab) => {
      const active = tab === selected;
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
      const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
      if (panel) panel.hidden = !active;
    });
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectTab(tab));
    tab.addEventListener("keydown", (event) => {
      let nextIndex: number | undefined;
      if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
      if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
      if (event.key === "Home") nextIndex = 0;
      if (event.key === "End") nextIndex = tabs.length - 1;
      if (nextIndex === undefined) return;
      event.preventDefault();
      selectTab(tabs[nextIndex]);
      tabs[nextIndex].focus();
    });
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!ideaField || !ideaField.value.trim()) {
      setStatus("Describe your application idea before generating the prompt.");
      ideaField?.focus();
      return;
    }
    renderFiles();
    selectTab(tabs[0]);
    setStatus("Your execution prompt and portable blueprint are ready.");
    root?.querySelector<HTMLElement>("#build-output-title")?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  form?.addEventListener("input", renderFiles);

  root?.querySelectorAll<HTMLButtonElement>("[data-example]").forEach((button) => {
    button.addEventListener("click", () => {
      if (ideaField) {
        ideaField.value = button.dataset.example ?? "";
        ideaField.dispatchEvent(new Event("input", { bubbles: true }));
        ideaField.focus();
      }
    });
  });

  ideaField?.addEventListener("input", () => {
    if (characterCount && ideaField) characterCount.textContent = String(ideaField.value.length);
  });

  const copyText = async (content: string, successMessage: string) => {
    try {
      await navigator.clipboard.writeText(content);
      setStatus(successMessage);
    } catch {
      setStatus("Copy is unavailable in this browser. Select the text in the preview and copy it manually.");
    }
  };

  root?.querySelector<HTMLButtonElement>("[data-copy-prompt]")?.addEventListener("click", () => {
    copyText(promptOutput?.textContent ?? "", "Execution prompt copied.");
  });
  root?.querySelector<HTMLButtonElement>("[data-copy-blueprint]")?.addEventListener("click", () => {
    copyText(blueprintOutput?.textContent ?? "", "Portable blueprint copied.");
  });

  const download = (content: string, filename: string, type: string) => {
    const url = URL.createObjectURL(new Blob([content], { type }));
    const link = document.createElement("a");
    link.href = url;
    link.download = filename;
    link.click();
    URL.revokeObjectURL(url);
  };

  root?.querySelector<HTMLButtonElement>("[data-download-files]")?.addEventListener("click", () => {
    download(promptOutput?.textContent ?? "", "ph7builder-execution-prompt.md", "text/markdown;charset=utf-8");
    download(blueprintOutput?.textContent ?? "", "ph7builder.blueprint.yaml", "text/yaml;charset=utf-8");
    setStatus("Execution prompt and blueprint downloaded.");
  });

  renderFiles();
</script>

<style>
  .build-header { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.6fr); align-items: end; gap: clamp(2rem, 6vw, 6rem); padding-block: clamp(4rem, 8vw, 7rem); }
  .build-header h1 { max-width: 12ch; margin-bottom: 0; }
  .build-header .lede { margin-bottom: 1rem; }
  .scope-note, .field-help, .privacy-note, .service-disclaimer { color: var(--ink-soft); font-size: 0.86rem; }
  .builder-shell { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); border: 2px solid var(--ink); border-radius: var(--radius); background: var(--paper-strong); box-shadow: var(--shadow); overflow: hidden; }
  .builder-form-panel, .builder-output-panel { min-width: 0; padding: clamp(1.25rem, 4vw, 2.5rem); }
  .builder-form-panel { border-right: 2px solid var(--ink); background: var(--yellow); }
  .panel-heading { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; align-items: start; padding-bottom: 2rem; border-bottom: 2px solid var(--ink); }
  .panel-heading h2 { margin: 0; font-family: var(--sans); font-size: clamp(1.5rem, 3vw, 2.2rem); letter-spacing: -0.035em; }
  .panel-heading p { margin: 0.25rem 0 0; color: var(--ink-soft); }
  .step-box { display: grid; width: 3.5rem; height: 3.5rem; place-items: center; border: 2px solid var(--ink); border-radius: 0.4rem; background: var(--lime); font-family: var(--mono); font-weight: 800; }
  form { padding-top: 1.75rem; }
  form > label, fieldset { display: grid; gap: 0.45rem; margin: 0 0 1rem; font-weight: 800; }
  textarea { width: 100%; min-height: 14rem; padding: 1rem; border: 2px solid var(--ink); border-radius: 0.5rem; background: var(--paper-strong); font-weight: 500; resize: vertical; }
  .field-help { margin: -0.6rem 0 1.5rem; text-align: right; }
  .example-ideas { padding: 1rem 0 1.5rem; border-top: 1px solid color-mix(in srgb, var(--ink) 35%, transparent); }
  .example-ideas > p { margin-bottom: 0.6rem; font-weight: 800; }
  .example-ideas > div { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .example-ideas button { padding: 0.5rem 0.65rem; border: 1px solid var(--ink); border-radius: 999px; background: var(--paper-strong); font-size: 0.78rem; font-weight: 700; }
  fieldset { padding: 1.25rem 0 0; border: 0; border-top: 1px solid color-mix(in srgb, var(--ink) 35%, transparent); }
  legend { margin-bottom: 0.75rem; }
  .agent-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
  .agent-options label { position: relative; }
  .agent-options input { position: absolute; opacity: 0; }
  .agent-options span { display: grid; min-height: 3.4rem; place-items: center; padding: 0.7rem; border: 2px solid var(--ink); border-radius: 0.4rem; background: var(--paper-strong); font-size: 0.86rem; text-align: center; }
  .agent-options input:checked + span { background: var(--lime); box-shadow: inset 0 0 0 2px var(--paper-strong); }
  .agent-options input:focus-visible + span { outline: 3px solid var(--blue); outline-offset: 2px; }
  form > .button { margin-top: 0.75rem; }
  .privacy-note { margin: 0.8rem 0 0; }
  .output-tabs { display: flex; gap: 0.25rem; padding-top: 1.75rem; border-bottom: 1px solid var(--line); }
  .output-tabs button { padding: 0.65rem 0.85rem; border: 0; border-bottom: 3px solid transparent; background: transparent; font-weight: 800; }
  .output-tabs button[aria-selected="true"] { border-bottom-color: var(--coral); }
  [role="tabpanel"] pre { min-height: 38rem; max-height: 58rem; overflow: auto; padding: 1.25rem; margin: 1rem 0; border-radius: 0.5rem; background: var(--ink); color: #f3f5fb; white-space: pre-wrap; overflow-wrap: anywhere; }
  [role="tabpanel"] code { font-family: var(--mono); font-size: 0.78rem; line-height: 1.65; }
  .output-status { min-height: 1.5rem; margin: 0 0 0.5rem; color: var(--ink-soft); font-size: 0.85rem; }
  .output-note { padding: 1.2rem; margin-top: 2rem; border: 1px solid var(--ink); border-left: 0.45rem solid var(--blue); background: var(--blue-soft); }
  .output-note ol { padding-left: 1.25rem; margin-bottom: 0; }
  .output-note li + li { margin-top: 0.4rem; }
  .build-explanation h2 { max-width: 14ch; }
  .build-explanation p:not(.eyebrow) { color: var(--ink-soft); font-size: 1.1rem; }
  .service-disclaimer { max-width: 54rem; margin: 2rem 0 0; }
  @media (max-width: 900px) { .build-header, .builder-shell { grid-template-columns: 1fr; } .builder-form-panel { border-right: 0; border-bottom: 2px solid var(--ink); } }
  @media (max-width: 560px) { .agent-options { grid-template-columns: 1fr; } .builder-form-panel, .builder-output-panel { padding: 1rem; } .tool-actions { display: grid; } }
</style>
