---
import { getCollection } from "astro:content";
import ArrowIcon from "../../components/ArrowIcon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { legacyRedirects } from "../../data/redirects";

const articles = (await getCollection("articles", ({ data }) => !data.draft && data.sourceType !== "release" && !(data.slug in legacyRedirects)))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = articles.filter((article) => article.data.featured).slice(0, 3);
const archive = articles.filter((article) => !featured.includes(article));
const dateFormatter = new Intl.DateTimeFormat("en", { month: "short", year: "numeric" });
---

<BaseLayout title="Articles" description="Practical pH7Builder guides, product decisions and the preserved release archive written by Pierre-Henry Soria." path="/articles/">
  <header class="page-hero shell">
    <p class="eyebrow">Articles by Pierre-Henry Soria</p>
    <h1>Build the product. Understand the decisions.</h1>
    <p class="lede">Practical guides for dating and community builders, plus the preserved pH7Builder release archive.</p>
  </header>

  {featured.length > 0 && <section class="section-tight surface">
    <div class="shell featured-grid">
      {featured.map((article, index) => (
        <article class:list={["featured-article", { lead: index === 0 }]}>
          <div><span>{article.data.categories[0] ?? "Guide"}</span><span>{dateFormatter.format(article.data.publishedAt)}</span></div>
          <h2><a href={`/${article.data.slug}/`}>{article.data.title}</a></h2>
          <p>{article.data.description}</p>
          <a class="text-link" href={`/${article.data.slug}/`}>Read the article<ArrowIcon /></a>
        </article>
      ))}
    </div>
  </section>}

  <section class="section shell">
    <div class="section-heading">
      <div><p class="eyebrow">Complete archive</p><h2>{archive.length} articles and release posts.</h2></div>
      <p>Older posts are retained for project history and clearly marked when they may no longer describe the current product.</p>
    </div>
    <div class="article-list">
      {archive.map((article) => (
        <article>
          <div class="article-list-meta"><span>{dateFormatter.format(article.data.publishedAt)}</span>{article.data.historical && <b>Archive</b>}</div>
          <h3><a href={`/${article.data.slug}/`}>{article.data.title}</a></h3>
          <p>{article.data.description}</p>
          <a class="text-link" href={`/${article.data.slug}/`} aria-label={`Read ${article.data.title}`}><ArrowIcon /></a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .featured-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .featured-article { display: flex; min-height: 23rem; flex-direction: column; padding: 1.75rem; border: 2px solid var(--ink); border-radius: .8rem; background: var(--blue-soft); }
  .featured-article.lead { grid-row: span 2; min-height: 47.25rem; background: var(--lime); }
  .featured-article > div { display: flex; justify-content: space-between; gap: 1rem; font-family: var(--mono); font-size: .68rem; font-weight: 800; text-transform: uppercase; }
  .featured-article h2 { margin: auto 0 1rem; font-size: clamp(2rem, 4vw, 3.4rem); }
  .featured-article h2 a { text-decoration: none; }
  .featured-article .text-link { margin-top: 1rem; }
  .article-list { border-top: 2px solid var(--ink); }
  .article-list article { display: grid; grid-template-columns: 9rem minmax(16rem, .8fr) 1fr auto; align-items: center; gap: 1.5rem; padding: 1.3rem 0; border-bottom: 1px solid var(--line); }
  .article-list-meta { display: flex; align-items: flex-start; flex-direction: column; gap: .35rem; font-family: var(--mono); font-size: .7rem; text-transform: uppercase; }
  .article-list-meta b { padding: .15rem .35rem; background: var(--yellow); }
  .article-list h3, .article-list p { margin: 0; }
  .article-list h3 { font-size: 1.15rem; }
  .article-list h3 a { text-decoration: none; }
  .article-list p { color: var(--ink-soft); font-size: .9rem; }
  @media (max-width: 800px) { .article-list article { grid-template-columns: 6rem 1fr auto; } .article-list article > p { display: none; } }
  @media (max-width: 620px) { .featured-grid { grid-template-columns: 1fr; } .featured-article.lead { grid-row: auto; min-height: 28rem; } .article-list article { grid-template-columns: 1fr auto; } .article-list-meta { grid-column: 1 / -1; flex-direction: row; } }
</style>
