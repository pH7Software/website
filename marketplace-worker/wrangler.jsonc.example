{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ph7builder-marketplace-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-26",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "vars": {
    "API_ORIGIN": "https://marketplace-api.ph7builder.com",
    "MARKETPLACE_ORIGIN": "https://ph7builder.com",
    "PAYPAL_ENVIRONMENT": "sandbox",
    "PAYPAL_MERCHANT_ID": "REPLACE_WITH_PAYPAL_MERCHANT_ID",
    "PACKAGE_STORAGE_DRIVER": "kv",
    "PURCHASES_ENABLED": "false",
    "ALLOW_PRODUCTION": "false"
  },
  "d1_databases": [
    {
      "binding": "ORDERS",
      "database_name": "ph7builder-marketplace",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PACKAGES",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
