{
  "name": "ph7builder-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "build:ci": "npm run test && npm run verify:marketplace && npm run verify:public-repo && npm run build && npm run verify:build",
    "test": "node --test scripts/*.test.mjs",
    "verify:marketplace": "node scripts/validate-marketplace.mjs",
    "verify:public-repo": "node scripts/verify-public-repo.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "astro": "^7.4.13",
    "typescript": "^5.9.3"
  }
}
